{
    "elements": [
        {
            "type": "ExpansionPanel",
            "caption": "Sensoren",
            "expanded": true,
            "items": [
                {
                    "type": "List",
                    "name": "Contacts",
                    "caption": "Tür-/Fensterkontakte",
                    "rowCount": 8,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "350px",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Name (leer = Variablenname)",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": { "type": "ValidationTextBox" }
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "ContactOpenValue",
                    "caption": "Kontakt meldet \"offen\" mit 1 (true)"
                },
                {
                    "type": "List",
                    "name": "MotionSensors",
                    "caption": "Bewegungsmelder (1 = Bewegung)",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "350px",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Name (leer = Variablenname)",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": { "type": "ValidationTextBox" }
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "Presence",
                    "caption": "Anwesenheit (1 = zuhause)",
                    "rowCount": 4,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "350px",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Name (leer = Variablenname)",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": { "type": "ValidationTextBox" }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "KNX Schärfen und Status",
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "ArmRequestVariableID",
                    "caption": "Scharf Request (1 = scharf Nacht, 0 = unscharf)"
                },
                {
                    "type": "SelectVariable",
                    "name": "ArmedStatusVariableID",
                    "caption": "System Armed (Status)"
                },
                {
                    "type": "List",
                    "name": "ArmedOutputs",
                    "caption": "Weitere Statusvariablen für scharf/unscharf (Schalten: 1/0, Werte: beliebig)",
                    "rowCount": 5,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "300px",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Wert scharf",
                            "name": "ArmedValue",
                            "width": "120px",
                            "add": 1,
                            "edit": { "type": "NumberSpinner" }
                        },
                        {
                            "caption": "Wert unscharf",
                            "name": "DisarmedValue",
                            "width": "120px",
                            "add": 0,
                            "edit": { "type": "NumberSpinner" }
                        },
                        {
                            "caption": "Gilt als scharf bei",
                            "name": "Mode",
                            "width": "auto",
                            "add": 0,
                            "edit": {
                                "type": "Select",
                                "options": [
                                    { "caption": "Abwesend und Nacht", "value": 0 },
                                    { "caption": "nur Abwesend", "value": 1 },
                                    { "caption": "nur Nacht", "value": 2 }
                                ]
                            }
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "RequestCanDisarmAway",
                    "caption": "Scharf Request 0 darf auch \"Abwesend\" unscharf schalten"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "ekey Fingerscanner (entschärft \"Abwesend\")",
            "items": [
                {
                    "type": "SelectVariable",
                    "name": "EkeyUserVariableID",
                    "caption": "Variable Benutzer-ID der ekey-Instanz"
                },
                {
                    "type": "SelectVariable",
                    "name": "EkeyFingerVariableID",
                    "caption": "Variable Finger-ID der ekey-Instanz"
                },
                {
                    "type": "SelectVariable",
                    "name": "EkeyActionVariableID",
                    "caption": "Variable Aktion (optional)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "EkeyActionValue",
                    "caption": "Wert der Aktion bei erkanntem Finger"
                },
                {
                    "type": "List",
                    "name": "EkeyUsers",
                    "caption": "Berechtigte Fingerabdrücke",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Benutzer-ID",
                            "name": "UserID",
                            "width": "150px",
                            "add": 1,
                            "edit": { "type": "NumberSpinner" }
                        },
                        {
                            "caption": "Finger-ID (-1 = jeder Finger)",
                            "name": "FingerID",
                            "width": "220px",
                            "add": -1,
                            "edit": { "type": "NumberSpinner", "minimum": -1 }
                        },
                        {
                            "caption": "Name",
                            "name": "Name",
                            "width": "auto",
                            "add": "",
                            "edit": { "type": "ValidationTextBox" }
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "EkeyNotifyRejected",
                    "caption": "Push bei nicht berechtigtem Fingerabdruck, solange scharf"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Aktoren",
            "items": [
                {
                    "type": "List",
                    "name": "Sirens",
                    "caption": "Sirenen / Signalgeber (DPT1)",
                    "rowCount": 3,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "AlarmLights",
                    "caption": "Licht bei Alarm (auf 100 %)",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Schalten",
                            "name": "SwitchVariableID",
                            "width": "350px",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Helligkeit (optional)",
                            "name": "BrightnessVariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "PreAlarmLights",
                    "caption": "Licht bei Voralarm (z. B. Flur)",
                    "rowCount": 3,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Schalten",
                            "name": "SwitchVariableID",
                            "width": "350px",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Helligkeit (optional)",
                            "name": "BrightnessVariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        }
                    ]
                },
                {
                    "type": "List",
                    "name": "Shutters",
                    "caption": "Rollläden / Jalousien bei Alarm öffnen",
                    "rowCount": 6,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "350px",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        },
                        {
                            "caption": "Wert für \"ganz auf\" (Auf/Ab: 0, Position: 0)",
                            "name": "OpenValue",
                            "width": "auto",
                            "add": 0,
                            "edit": { "type": "NumberSpinner" }
                        }
                    ]
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "KNX Textausgabe (DPT16, max. 14 Zeichen)",
            "items": [
                {
                    "type": "List",
                    "name": "TextOutputs",
                    "caption": "Textvariablen (z. B. Displays, Tastsensoren)",
                    "rowCount": 3,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "TextReplaceUmlauts",
                    "caption": "Umlaute ersetzen und Sonderzeichen entfernen (für DPT16.000 ASCII)"
                },
                { "type": "Label", "caption": "Zustandsmeldungen bleiben stehen, bis der Zustand endet, und werden dann mit leerem Text zurückgenommen:" },
                { "type": "CheckBox", "name": "TextAlarm", "caption": "Alarm mit erstem Auslöser, bis unscharf (\"ALARM Haustuer\")" },
                { "type": "CheckBox", "name": "TextPreAlarm", "caption": "Voralarm (\"Voralarm 30s\")" },
                { "type": "CheckBox", "name": "TextExcluded", "caption": "Ausgeklammerte Kontakte, bis geschlossen (\"Offen: Kueche\", \"3 Kont. offen\"), Hinweis beim Schließen (\"OK: Kueche\")" },
                { "type": "Label", "caption": "Hinweise werden nach der Anzeigedauer wieder ausgeblendet:" },
                {
                    "type": "NumberSpinner",
                    "name": "TextInfoDuration",
                    "caption": "Anzeigedauer Hinweise (0 = bis zur nächsten Meldung)",
                    "suffix": " s",
                    "minimum": 0
                },
                { "type": "CheckBox", "name": "TextArmed", "caption": "Scharf (\"Scharf Nacht\", \"Scharf Abwes.\")" },
                { "type": "CheckBox", "name": "TextDisarmed", "caption": "Unscharf (\"Unscharf\")" },
                { "type": "CheckBox", "name": "TextSirenOff", "caption": "Sirene aus (\"Sirene aus\")" },
                { "type": "CheckBox", "name": "TextEkeyRejected", "caption": "ekey: nicht berechtigter Finger, solange scharf (\"Finger abgel.\")" },
                { "type": "Label", "caption": "Countdown (zweite Meldung, sekündlich aktualisiert, danach mit leerem Text zurückgenommen):" },
                {
                    "type": "List",
                    "name": "CountdownOutputs",
                    "caption": "Textvariablen für den Countdown",
                    "rowCount": 3,
                    "add": true,
                    "delete": true,
                    "columns": [
                        {
                            "caption": "Variable",
                            "name": "VariableID",
                            "width": "auto",
                            "add": 0,
                            "edit": { "type": "SelectVariable" }
                        }
                    ]
                },
                { "type": "CheckBox", "name": "CountdownArm", "caption": "Schärf-Verzögerung Nacht und Abwesend (\"Scharf in 25s\", \"Scharf in 4:59\")" },
                { "type": "CheckBox", "name": "CountdownPreAlarm", "caption": "Voralarm (\"Alarm in 25s\")" },
                { "type": "CheckBox", "name": "CountdownTimeOnly", "caption": "Nur die Zeit ausgeben (\"25s\", \"4:59\")" }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Zeiten",
            "items": [
                {
                    "type": "NumberSpinner",
                    "name": "EntryDelay",
                    "caption": "Voralarm bis Alarm",
                    "suffix": " s",
                    "minimum": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "SirenDelay",
                    "caption": "Alarm bis Sirene",
                    "suffix": " s",
                    "minimum": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "SirenDuration",
                    "caption": "Sirenendauer (max. 3 Minuten empfohlen)",
                    "suffix": " s",
                    "minimum": 1
                },
                {
                    "type": "NumberSpinner",
                    "name": "NightArmDelay",
                    "caption": "Ausgangsverzögerung (Nacht über Request/HomeKit, Abwesend über HomeKit; 0 = sofort)",
                    "suffix": " s",
                    "minimum": 0
                },
                {
                    "type": "NumberSpinner",
                    "name": "AwayArmDelay",
                    "caption": "Niemand zuhause bis \"Abwesend\" scharf",
                    "suffix": " s",
                    "minimum": 0
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Benachrichtigung und Optionen",
            "items": [
                {
                    "type": "SelectInstance",
                    "name": "VisuID",
                    "caption": "Kachel-Visualisierung für Push-Nachrichten"
                },
                {
                    "type": "CheckBox",
                    "name": "NotifyArmDisarm",
                    "caption": "Push auch bei scharf/unscharf"
                },
                {
                    "type": "CheckBox",
                    "name": "AllowVisuControl",
                    "caption": "Modus über die Visualisierung schaltbar"
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Apple HomeKit Sicherheitssystem",
            "items": [
                {
                    "type": "Select",
                    "name": "HomeKitSource",
                    "caption": "HomeKit-Variable",
                    "options": [
                        { "caption": "Keine", "value": 0 },
                        { "caption": "Vom Modul anlegen (in der HomeKit Bridge auswählen)", "value": 1 },
                        { "caption": "Vorhandene Variable verwenden", "value": 2 }
                    ]
                },
                {
                    "type": "SelectVariable",
                    "name": "HomeKitVariableID",
                    "caption": "Vorhandene Variable (Integer, Profil SecuritySystem.HomeKit)"
                },
                {
                    "type": "Select",
                    "name": "HomeKitHomeAs",
                    "caption": "HomeKit \"Zuhause\" bedeutet",
                    "options": [
                        { "caption": "Scharf (Nacht)", "value": 2 },
                        { "caption": "Ignorieren", "value": -1 }
                    ]
                },
                {
                    "type": "CheckBox",
                    "name": "HomeKitCanDisarmAway",
                    "caption": "HomeKit \"Aus\" darf auch \"Abwesend\" unscharf schalten"
                },
                {
                    "type": "Label",
                    "caption": "Für \"Alarm ausgelöst\" in HomeKit die Modulvariable \"Alarm ausgelöst\" als AlarmID in der Bridge eintragen."
                }
            ]
        },
        {
            "type": "ExpansionPanel",
            "caption": "Testmodus und Sensorprotokoll",
            "items": [
                {
                    "type": "CheckBox",
                    "name": "TestMode",
                    "caption": "Testmodus (Sirenen werden nicht geschaltet, alle Sensorereignisse werden protokolliert)"
                },
                {
                    "type": "NumberSpinner",
                    "name": "TestFlapSeconds",
                    "caption": "Als Flattern werten, wenn ein Sensor schneller wechselt als",
                    "suffix": " s",
                    "minimum": 1
                },
                {
                    "type": "CheckBox",
                    "name": "TestLogCsv",
                    "caption": "Zusätzlich als CSV-Datei im Symcon-Log-Ordner speichern"
                }
            ]
        }
    ],
    "actions": [
        { "type": "Button", "caption": "Scharf (Nacht)", "onClick": "ALARM_ArmNight($id);" },
        { "type": "Button", "caption": "Scharf (Abwesend)", "onClick": "ALARM_ArmAway($id);" },
        { "type": "Button", "caption": "Unscharf", "onClick": "ALARM_Disarm($id);" },
        { "type": "Button", "caption": "Status anzeigen", "onClick": "echo ALARM_GetStatusText($id);" },
        { "type": "Button", "caption": "Testprotokoll anzeigen", "onClick": "echo ALARM_GetTestReport($id);" },
        { "type": "Button", "caption": "Testprotokoll löschen", "onClick": "ALARM_ResetTestLog($id); echo 'Testprotokoll gelöscht.';" }
    ],
    "status": [
        { "code": 102, "icon": "active", "caption": "Alarmanlage bereit" },
        { "code": 104, "icon": "inactive", "caption": "Keine Tür-/Fensterkontakte konfiguriert" },
        { "code": 201, "icon": "error", "caption": "Mindestens eine konfigurierte Variable existiert nicht (siehe Meldungen)" }
    ]
}
